# =============================================================================
# Frontend Security Converter - Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------

# Cookie secret key for session management (minimum 32 characters)
# IMPORTANT: Generate a unique key for production environments
COOKIE_SECRET_KEY=abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ01

# Environment mode: "test" or "production"
# - test: Uses localhost defaults for API and server
# - production: Requires HOST, PORT, and GRAPHQL_API_TARGET to be set
ENVIRONMENT=test

# -----------------------------------------------------------------------------
# Production Server Settings (only used when ENVIRONMENT=production)
# -----------------------------------------------------------------------------

# Server binding address (use 0.0.0.0 to listen on all interfaces)
# HOST=0.0.0.0

# Server port
# PORT=8088

# GraphQL API endpoint for the security-converter backend
# GRAPHQL_API_TARGET=http://security-converter-api.security-converter.svc.cluster.local/graphql

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# The application uses an LLM to extract security metadata from documents.
# Two providers are supported: Ollama (local/self-hosted) and Google Gemini (cloud).

# LLM Provider selection: "ollama" (default) or "gemini"
LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# Ollama Configuration (used when LLM_PROVIDER=ollama)
# -----------------------------------------------------------------------------
# Ollama is an open-source local LLM runner. See: https://ollama.ai

# Ollama server URL
OLLAMA_HOST=http://localhost

# Ollama server port (default Ollama port is 11434)
OLLAMA_PORT=11434

# Default model to use for metadata extraction
# Recommended models: llama3:8b (balanced), mistral:7b (fast), gemma2:27b (accurate)
OLLAMA_MODEL=llama3:8b

# -----------------------------------------------------------------------------
# Google Gemini Configuration (used when LLM_PROVIDER=gemini)
# -----------------------------------------------------------------------------
# Google Gemini is a cloud-based LLM service.
# Get an API key from: https://makersuite.google.com/app/apikey

# Google Cloud API key with Gemini API access (REQUIRED for Gemini provider)
# GEMINI_API_KEY=your-api-key-here

# Default Gemini model to use
# Options: gemini-1.5-flash (fast), gemini-1.5-pro (more capable)
# GEMINI_MODEL=gemini-1.5-flash
